# Template for backend/.env when running under docker-compose.
#
# Copy this to backend/.env and fill in the real values, then always invoke
# compose as:  docker compose --env-file backend/.env <command>
# (see DEPLOYMENT.md for why --env-file is required).
#
# Vars marked "compose-managed" are set directly in docker-compose.yml for
# the backend service and will be OVERRIDDEN there - the values you put here
# for them only matter for running the backend outside Docker.

# --- External, read-only MaddenCo ERP MySQL connection ---------------------
# A real server your team already has access to - NOT provided by this
# compose stack. Never point this at the etop-db compose service.
MYSQL_HOST=mysql-dev.kmdevlab.com
MYSQL_PORT=3306
MYSQL_DATABASE=replace_with_real_erp_schema
MYSQL_USER=replace_with_real_erp_user
MYSQL_PASSWORD=replace_locally
MYSQL_CONNECTION_TIMEOUT=10

# --- App's own MySQL database (the `etop` schema) ---------------------------
# ETOP_DB_HOST/ETOP_DB_PORT are compose-managed (docker-compose.yml points
# them at the etop-db service). ETOP_DB_NAME/ETOP_DB_USER/ETOP_DB_PASSWORD
# are used both to seed the etop-db container on first start AND by the
# backend to connect - keep them consistent.
ETOP_DB_HOST=127.0.0.1
ETOP_DB_PORT=3306
ETOP_DB_NAME=etop
ETOP_DB_USER=etop_app
ETOP_DB_PASSWORD=replace_locally

# --- Ollama (AI features: SQL assistant, document-intelligence chat) -------
# OLLAMA_BASE_URL is compose-managed (points at the ollama service). Models
# used are hardcoded, not configurable via env, except SQL_AI_MODEL - after
# first `docker compose up`, pull all three once (see DEPLOYMENT.md):
#   qwen2.5-coder:7b (SQL AI, default for SQL_AI_MODEL)
#   gemma3:12b (chat)
#   nomic-embed-text (embeddings)
OLLAMA_BASE_URL=http://127.0.0.1:11434
SQL_AI_MODEL=qwen2.5-coder:7b
SQL_AI_MAX_SCHEMA_OBJECTS=15
SQL_AI_MAX_COLUMNS_PER_OBJECT=80

# --- Frontend origin / CORS / session ---------------------------------------
# REQUIRED for production - defaults to the Vite dev server origins if unset,
# which is wrong for any real deployment.
ETOP_APP_URL=https://your-frontend-domain.example.com
# REQUIRED for production - must be at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ETOP_SESSION_SIGNING_SECRET=replace_with_a_real_random_secret_at_least_32_chars
ETOP_SESSION_NAMESPACE=etop-local
ETOP_COOKIE_NAME=etop_local_session
ETOP_COOKIE_DOMAIN=

# --- OCR --------------------------------------------------------------------
# Leave unset - the Dockerfile installs tesseract-ocr on PATH already.
# Only set this if you need to point at a non-default tesseract binary.
TESSERACT_CMD=
ETOP_LOCKBOX_OCR_WORKERS=

# --- SQL Workspace / customer-lookup ERP field overrides (optional) --------
MADDEN_SCHEMA=DTA273
MADDEN_CUSTOMER_TABLE=TMCUST
SQL_TIMEOUT_SECONDS=60
SQL_DEFAULT_LIMIT=500
SQL_MAX_LIMIT=5000
SQL_AUTOMATION_ROW_LIMIT=100000
# Per-field ERP column overrides, only needed if a field's default column
# name is wrong for your MaddenCo instance - e.g.:
# ETOP_CUSTOMER_PHONE_COLUMN=TCUPHONE

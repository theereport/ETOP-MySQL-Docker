# Safe placeholder configuration
# Do not place production credentials in this file.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=example_database
MYSQL_USER=example_user
MYSQL_PASSWORD=replace_locally

# App's own MySQL database (the etop schema - all app modules' own data).
# Separate host/credentials from the read-only MYSQL_* ERP connection above.
ETOP_DB_HOST=127.0.0.1
ETOP_DB_PORT=3306
ETOP_DB_NAME=etop
ETOP_DB_USER=example_user
ETOP_DB_PASSWORD=replace_locally

OLLAMA_BASE_URL=http://127.0.0.1:11434

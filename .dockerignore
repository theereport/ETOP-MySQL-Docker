**/__pycache__/
**/*.pyc
backend/.venv/
backend/.pytest_cache/

# Frontend (built/deployed separately from the backend image)
node_modules/
dist/
src/
public/
index.html
package.json
package-lock.json
vite.config.ts
tsconfig*.json
eslint.config.js

# VCS / editor / misc project scaffolding not needed at runtime

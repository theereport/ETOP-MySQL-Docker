# Never let real credentials into an image layer.
backend/.env
backend/.env.compose

# Archived pre-migration SQLite files (~1.2GB, dead weight for the image).
archive/

# Python
**/__pycache__/
**/*.pyc
backend/.venv/
backend/.pytest_cache/

# Frontend source (src/, public/, index.html, package*.json, vite/tsconfig)
# is NOT excluded here - Dockerfile.frontend builds it into the reverse-proxy
# image. Only its own build output/deps are excluded, since Dockerfile.
# frontend runs `npm ci` and `npm run build` inside the container itself.
node_modules/
dist/
eslint.config.js

# VCS / editor / misc project scaffolding not needed at runtime
.git/
.claude/
docs/
tests/
verification/
Executive Discussion Log/
ETOP-Launcher/
*.log
